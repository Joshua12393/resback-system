        <mxCell id="p2_rules" value="Registration creates an active Student and signs in. Login accepts&#10;active accounts.&#10;Admin/Super Admin/Faculty land on the dashboard; Students land&#10;on the feedback form.&#10;Login/logout use Laravel Auth and session services; framework&#10;facade dependencies are omitted." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="700" y="230" width="500" height="158" as="geometry" />
        </mxCell>
        <mxCell id="p2_accountRules" value="Admins may manage Student/Faculty accounts. Super Admin may manage&#10;other administrator accounts and delete others. Self role/status changes&#10;and self deletion are blocked." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="1480" width="560" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p2_profileRules" value="Profile editing changes nickname and profile photo. Photo files use&#10;the public storage disk. Email/password editing and a password-reset&#10;flow are not implemented." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1270" y="710" width="520" height="92" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
