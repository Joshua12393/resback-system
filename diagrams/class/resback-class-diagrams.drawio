        </mxCell>
        <mxCell id="p5_reports" value="Excel creates a Spreadsheet and Xlsx writer; PDF creates Dompdf.&#10;Matching CCIS feedback is exported without submitter identity; rejected&#10;feedback is excluded.&#10;FeedbackDateRange stores immutable optional bounds and applies the&#10;same date scope to queries." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
