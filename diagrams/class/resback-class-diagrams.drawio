        <mxCell id="p6_activeRule" value="Alias: active&#10;Inactive accounts are logged out; the session is invalidated and the&#10;CSRF token regenerated, then the user is sent to login with an error." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="650" width="520" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6_dashboardRule" value="Alias: admin&#10;Faculty, Admin and Super Admin may open dashboards and reports.&#10;Other authenticated roles receive 403." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1270" y="650" width="520" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6_adminRule" value="Alias: admin.only&#10;Admin/Super Admin may enter account-management and&#10;feedback-deletion routes. AccountController applies additional target&#10;and operation restrictions." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="1330" width="520" height="114" as="geometry" />
        </mxCell>
        <mxCell id="p6_submitRule" value="Alias: feedback.submitter&#10;Admin/Super Admin GET requests redirect to the dashboard;&#10;non-GET requests return 403. Student/Faculty may continue." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1330" width="520" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6_framework" value="Laravel auth / guest middleware and framework&#10;Request, Closure, Auth, session and Response types&#10;are omitted as classes. These middleware classes do&#10;not inherit from each other." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="740" y="1150" width="430" height="114" as="geometry" />
