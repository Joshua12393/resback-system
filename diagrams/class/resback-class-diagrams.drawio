        <mxCell id="p4_gemma" value="SentimentService sends feedback to Gemma through the&#10;Gemini API. Successful analysis stores normalized&#10;sentiment, confidence, keywords, topics and languages.&#10;Failures set Feedback.status to failed." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1420" y="250" width="450" height="114" as="geometry" />
        </mxCell>
        <mxCell id="p4_rankRule" value="ConcernRankingService reads SentimentResult and related Feedback,&#10;queries Category, and writes ConcernRanking.&#10;Score: 40% normalized negative volume, 25% negative ratio, 20%&#10;average negative confidence, 15% recency.&#10;These shared model/query dependencies are summarized here to keep&#10;this view readable." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="1530" width="550" height="158" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
