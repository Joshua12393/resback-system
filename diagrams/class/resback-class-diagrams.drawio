        <mxCell id="p1_roles" value="User.role values: student, faculty, admin, super_admin.&#10;Roles are values, not subclasses.&#10;Feedback.status: pending, analyzed, failed, rejected.&#10;SentimentResult.sentiment: positive, neutral, negative." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="1070" width="440" height="114" as="geometry" />
        </mxCell>
        <mxCell id="p1_ownership" value="User/Category deletion sets the corresponding Feedback foreign key to null.&#10;Feedback deletion cascades to SentimentResult.&#10;User extends Laravel Authenticatable; the other four domain classes extend&#10;Eloquent Model. Legacy name parts and authentication bookkeeping are&#10;    omitted." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="1340" width="570" height="136" as="geometry" />
        </mxCell>
        <mxCell id="p1_constraint" value="0..1 analysis reflects Eloquent hasOne and the application&#10;workflow. The database does not enforce&#10;    UNIQUE(feedback_id).&#10;ConcernRanking is unique by (category_id, keyword);&#10;keyword stores the normalized topic." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1370" y="770" width="450" height="136" as="geometry" />
        </mxCell>
