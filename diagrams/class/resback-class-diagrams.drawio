        <mxCell id="p5_shared" value="Shared dependencies (not repeated as arrows): all three&#10;controllers use Feedback, FeedbackDateRange and&#10;    LanguageCategoryService.CATEGORY_LABELS.&#10;Dashboard/PDF also query Category and analysis data;&#10;Dashboard directly queries SentimentResult." style="fontFamily=Arial;html=0;fontColor=#253349;shape=note;size=18;fillColor=#fff9e9;strokeColor=#c8b87d;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=14;fontSize=16;" vertex="1" parent="1">
