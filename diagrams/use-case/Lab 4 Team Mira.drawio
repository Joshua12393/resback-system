        <mxCell id="caption" value="Super Admin inherits Admin permissions. Admin manages Student/Faculty roles and status.&#10;Protected operations require an active session; registration creates a Student account." style="shape=text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=17;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1">
